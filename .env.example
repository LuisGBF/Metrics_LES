# Fuso horario usado nas analises (formato IANA).
ANALYTICS_TZ=America/Sao_Paulo

# Opcional: caminho do banco SQLite.
# DB_PATH=data/analytics.db

# YouTube - conta propria (OAuth, dados completos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube - outros canais (somente dados publicos, sem OAuth)
YT_API_KEY=
# Canal padrao quando usar --mode public sem --profile.
YT_CHANNEL_HANDLE=

# X API (console.x.com -> seu App -> OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/callback

# X - leitura de perfis de terceiros (app-only / bearer token)
X_BEARER_TOKEN=

# Trava de orcamento do coletor do X (em dolares).
X_BUDGET_USD=2.00
# Custo por post lido: propria conta vs. perfil de terceiro.
X_OWNED_READ_USD=0.001
X_THIRD_PARTY_READ_USD=0.005

# Periodo inicial das consultas do YouTube (AAAA-MM-DD).
YT_START_DATE=2008-01-01
