# Fuso horario usado nas analises (formato IANA).
ANALYTICS_TZ=America/Sao_Paulo

# Opcional: caminho do banco SQLite.
# DB_PATH=data/analytics.db

# YouTube - alternativa a colocar .secrets/client_secret.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X API (console.x.com -> seu App -> OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/callback

# Trava de orcamento do coletor do X (em dolares).
X_BUDGET_USD=2.00
X_OWNED_READ_USD=0.001

# Periodo inicial das consultas do YouTube (AAAA-MM-DD).
YT_START_DATE=2008-01-01
